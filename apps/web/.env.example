NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Web Push (PWA — issue #275) -------------------------------------------
# Generate a VAPID key-pair once with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
# Set on the *server* side only (these are not NEXT_PUBLIC_* variables).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URI identifying your deployment.
VAPID_SUBJECT=mailto:admin@sorolens.dev

# Shared secret that guards the internal PUT /api/push/subscribe endpoint.
# Set to any random string.  Leave empty to disable the auth guard in dev.
PUSH_INTERNAL_SECRET=

# Set to "true" to enable the service worker in development (default: off).
# In production (NODE_ENV=production) the service worker is always enabled.
NEXT_PUBLIC_PWA_ENABLED=false
